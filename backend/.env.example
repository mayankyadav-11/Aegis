# AEGIS 2.0 Backend Configuration Example
# Copy this file to .env and configure your values.
# Never commit the real .env file to version control.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Pretrained Gemini Analysis (Required for deep LLM contextual analysis)
# If left empty, AEGIS automatically operates in Python deterministic-only fallback mode.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12.0

# Inspection Security Limits
MAX_REDIRECTS=5
URL_REQUEST_TIMEOUT_SECONDS=4.0
MAX_RESPONSE_BYTES=250000

# AEGIS 2.0 Backend Environment Variables
# Copy this file to .env and fill in the values.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Pretrained Gemini Analysis (Required for deep LLM contextual explanation)
# If left empty, AEGIS automatically operates in deterministic-only fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12.0

# Inspection Security Limits
MAX_REDIRECTS=5
URL_REQUEST_TIMEOUT_SECONDS=4.0
MAX_RESPONSE_BYTES=250000
